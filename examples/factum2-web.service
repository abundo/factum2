
# factum2-web.service, start factum web

[Unit]
Description=Factum web
After=network.target network-online.target
Requires=network-online.target
# RestartSec=10 plus a 60s/5-burst window always trips after five
# crashes and leaves the unit failed. Disable start-rate limiting so
# the process keeps retrying until the fault clears.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/factum2
ExecStart=/opt/factum2/factum2-web -f /etc/factum2/factum2.yaml start
TimeoutStopSec=10s

Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
