# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#

# build output
build/
bin/
dist/
web/static/vue/

# javascript, css
node_modules/

# Local GOPATH / module-cache leftover (never vendor)
pkg/

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/


# Go workspace file
go.work

# Skill runtime state (skills themselves under .grok/skills are committed)
.grok/skills/**/.state/

# Compose lab runtime (seed.sh / dest-file sync). Templates and empty
# placeholders under dev/data stay in git; generated env is local-only.
dev/data/librenms.env
dev/env.sh
dev/data/oxidized/config
dev/data/oxidized/log
dev/data/oxidized/logs/
dev/data/oxidized/pid
dev/data/oxidized/configs/
dev/data/oxidized/crashes/
dev/certs/

# Python (install.py)
__pycache__/
*.py[cod]
