# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#

# build output
build/
bin/
dist/
web/static/vue/
# Wiregasm (make wiregasm). Served from disk; not part of the Vue bundle.
web/static/wiregasm/

# javascript, css
node_modules/

# Local GOPATH / module-cache leftover (never vendor)
pkg/

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/


# Go workspace file (local library development; see DEV.md).
# A dnsmgr2 checkout used by that workspace belongs beside this repo
# (../dnsmgr2). Ignore one placed inside the tree so it is not added
# as a gitlink.
go.work
go.work.sum
/dnsmgr2/

# Skill runtime state (skills themselves under .grok/skills are committed)
.grok/skills/**/.state/

# MkDocs local build (repo root only; do not ignore views named site/)
/site/

# Compose lab runtime (seed.py / dest-file sync). prepare.py creates dest
# files if missing; do not track them — the first sync rewrites them.
dev/data/
dev/env.sh
# Local NetBox API seed inventory (copy of netbox-seed.example.yaml)
dev/netbox-seed.yaml
dev/certs/
dev/.dnsmgr2-src/

# Python (install.py)
__pycache__/
*.py[cod]
