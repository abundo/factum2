# Lab directory for dc=lab,dc=example. Passwords are lab (users) — the
# directory admin is cn=admin,dc=lab,dc=example / admin, set by the image.
# Roles are created after the users so the memberOf overlay can stamp
# membership onto each person.

dn: ou=people,dc=lab,dc=example
objectClass: organizationalUnit
ou: people

dn: ou=roles,dc=lab,dc=example
objectClass: organizationalUnit
ou: roles

