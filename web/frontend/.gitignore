# Vite
*.timestamp-*-*.mjs

# Copied by predev/prebuild (see package.json) from the installed
# maplibre-gl version - Vite/Rolldown doesn't emit maplibre's worker chunk
# via its usual new URL(..., import.meta.url) asset detection, so it's
# served as a plain static file instead (see NetworkMap.vue's setWorkerUrl
# call). maplibre-gl-shared.mjs is worker.mjs's own sibling import (a
# relative `from "./maplibre-gl-shared.mjs"` inside the raw dist file, so
# it must be copied alongside it, unprocessed, at the same path) - both
# regenerated on every dev/build, never hand-edited.
/public/maplibre-gl-worker.mjs
/public/maplibre-gl-shared.mjs
